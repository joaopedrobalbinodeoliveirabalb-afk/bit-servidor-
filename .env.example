PORT=3000
# Configure esta chave somente nas variáveis privadas do serviço de hospedagem.
# Nunca publique sua chave real no GitHub nem no navegador.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# IA reserva 1 (opcional): chave privada da OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# IA reserva 2 (opcional): Cloudflare Workers AI.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash
# Pesquisa na web (opcional).
BRAVE_SEARCH_API_KEY=
# Opcional: URL do site que poderá acessar a API, separadas por vírgula.
FRONTEND_URL=
